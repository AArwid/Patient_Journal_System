# Copy to .env and adjust per server instance.
# Run two instances to simulate the P2P setup, e.g.:
#   copy .env.example .env.hospital   (PORT=3001, SERVER_ID=hospital-1)
#   copy .env.example .env.ambulance  (PORT=3002, SERVER_ID=ambulance-1)

PORT=3001
SERVER_ID=hospital-1
SESSION_SECRET=change-me-in-each-env
DB_PATH=./data/patient_journal.db
BLOCKCHAIN_PATH=./data/audit-blockchain.json
# The frontend's Vite dev server runs on port 3000 (see frontend/vite.config.js).
CLIENT_ORIGIN=http://localhost:3000

# Comma-separated list of the other server(s) in the P2P network, used by
# the P2P layer to sync audit blocks and notes.
PEER_URLS=http://localhost:3002

# The server creates an Ed25519 key pair here on first start.
BLOCKCHAIN_KEY_DIRECTORY=./keys

# Map each peer server ID to its public key PEM file, so this server only
# trusts audit blocks signed by a peer it knows about.
# Leave this empty for a single-server run. For the two-server demo: start
# both servers once first (so each generates its own key pair under
# BLOCKCHAIN_KEY_DIRECTORY), then fill this in with the OTHER server's
# <server-id>.public.pem path and restart.
# Example: PEER_PUBLIC_KEYS=hospital-2=./keys/hospital-2.public.pem
PEER_PUBLIC_KEYS=
